{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "@better-compact/pi",
    "version": "0.3.1",
    "type": "module",
    "description": "pi and Oh My Pi extension that improves long-session context with boundary-time pruning",
    "keywords": [
        "pi-package",
        "pi",
        "oh-my-pi",
        "omp",
        "context",
        "pruning",
        "tokens"
    ],
    "pi": {
        "extensions": [
            "./dist/extension.js"
        ]
    },
    "omp": {
        "extensions": [
            "./dist/omp.js"
        ]
    },
    "main": "./dist/extension.js",
    "exports": {
        ".": "./dist/extension.js",
        "./omp": "./dist/omp.js"
    },
    "files": [
        "dist/"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/AshishKumar4/better-compact.git",
        "directory": "packages/pi"
    },
    "bugs": {
        "url": "https://github.com/AshishKumar4/better-compact/issues"
    },
    "homepage": "https://github.com/AshishKumar4/better-compact#readme",
    "author": "AshishKumar4",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "clean": "rm -rf dist",
        "build": "pnpm run clean && tsup",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts",
        "smoke:omp": "bun run scripts/smoke-omp.ts"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "@oh-my-pi/pi-ai": "*",
        "@oh-my-pi/pi-coding-agent": "*",
        "@oh-my-pi/pi-tui": "*"
    },
    "peerDependenciesMeta": {
        "@earendil-works/pi-agent-core": {
            "optional": true
        },
        "@earendil-works/pi-ai": {
            "optional": true
        },
        "@earendil-works/pi-coding-agent": {
            "optional": true
        },
        "@earendil-works/pi-tui": {
            "optional": true
        },
        "@oh-my-pi/pi-ai": {
            "optional": true
        },
        "@oh-my-pi/pi-coding-agent": {
            "optional": true
        },
        "@oh-my-pi/pi-tui": {
            "optional": true
        }
    },
    "devDependencies": {
        "@better-compact/core": "workspace:*",
        "@earendil-works/pi-agent-core": "^0.80.6",
        "@earendil-works/pi-ai": "^0.80.6",
        "@earendil-works/pi-coding-agent": "^0.80.6",
        "@earendil-works/pi-tui": "^0.80.6",
        "@oh-my-pi/pi-ai": "^17.3.4",
        "@oh-my-pi/pi-coding-agent": "^17.3.4",
        "@oh-my-pi/pi-tui": "^17.3.4",
        "@types/node": "^25.5.0",
        "tsup": "^8.5.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2"
    }
}
